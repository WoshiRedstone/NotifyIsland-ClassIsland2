<controls:ComponentBase xmlns:ci="http://classisland.tech/schemas/xaml/core"
                        x:TypeArguments="models:HttpTextComponentSettings"
                        x:Class="cn.lixiaotuan.notifyisland.Controls.HttpTextComponentSettingsControl"
                        xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:local="clr-namespace:cn.lixiaotuan.notifyisland.Controls"
                        xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
                        xmlns:models="clr-namespace:cn.lixiaotuan.notifyisland.Models"
                        xmlns:fluent="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                        mc:Ignorable="d"
                        d:DesignHeight="450" d:DesignWidth="600">
    <ScrollViewer>
        <StackPanel Classes="component-settings-container animated-intro" Margin="0"
                    DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:HttpTextComponentSettingsControl}}">

            <fluent:SettingsExpander IconSource="{ci:FluentIconSource &#xEDC7;}"
                                     Header="组件 ID"
                                     Description="用于 HTTP 接口寻址的唯一标识，请求 POST http://&lt;监听地址&gt;:&lt;端口&gt;/&lt;组件ID&gt; 即可更新此组件。">
                <fluent:SettingsExpander.Footer>
                    <TextBox MinWidth="220"
                             Watermark="例如 classroom-notice"
                             Text="{Binding Settings.Token, UpdateSourceTrigger=PropertyChanged}"/>
                </fluent:SettingsExpander.Footer>
            </fluent:SettingsExpander>

            <fluent:SettingsExpander IconSource="{ci:FluentIconSource &#xF26F;}"
                                     Header="字号"
                                     Description="调整此组件显示文本的大小。">
                <fluent:SettingsExpander.Footer>
                    <Slider MinWidth="200"
                            Minimum="10" Maximum="48"
                            TickFrequency="1" TickPlacement="None"
                            IsSnapToTickEnabled="True"
                            Value="{Binding Settings.FontSize}"/>
                </fluent:SettingsExpander.Footer>
            </fluent:SettingsExpander>

            <fluent:SettingsExpander IconSource="{ci:FluentIconSource &#xE7C9;}"
                                     Header="自定义字体颜色"
                                     Description="启用后使用下方颜色显示文本，否则使用主题默认前景色。">
                <fluent:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ColorPicker Color="{Binding Settings.FontColor, Mode=TwoWay}"
                                     IsVisible="{Binding Settings.UseCustomFontColor}"/>
                        <ToggleSwitch IsChecked="{Binding Settings.UseCustomFontColor}"/>
                    </StackPanel>
                </fluent:SettingsExpander.Footer>
            </fluent:SettingsExpander>

        </StackPanel>
    </ScrollViewer>
</controls:ComponentBase>
